# Database connection to Central Node
DATABASE_DSN=postgresql://postgres@ccscloud.dlsu.edu.ph:60832/node0db

# Node identification
NODE_NAME=node0

# Master configuration
DEFAULT_MASTER=node0
DEFAULT_MASTER_URL=http://localhost:8000

# Peer nodes
PEER_NODES=[{"name":"node0","url":"http://localhost:8000"},{"name":"node1","url":"http://localhost:8001"},{"name":"node2","url":"http://localhost:8002"}]

# Worker intervals (seconds)
POLL_INTERVAL=5
APPLIER_INTERVAL=2

# Promotion settings
PROMOTED=false
PARTITION_RULE=5

# Logging
LOG_LEVEL=INFO