                    {node2Data.length > 5 && (
                      <TableRow>
                        <TableCell colSpan={2} className="text-center text-gray-500 py-2 text-xs">
                          ... and {node2Data.length - 5} more
                        </TableCell>
                      </TableRow>
                    )}
                  </TableBody>
                </Table>
              </div>
            </CardContent>
          </Card>
        </div>
      </div>
    </div>
  );
}
