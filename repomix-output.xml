                            <div>
                              <p className="text-2xl font-semibold">{snapshot?.quantity ?? '—'}</p>
                              <p className="text-xs text-slate-500">Updated {snapshot?.updated_at ? new Date(snapshot.updated_at).toLocaleTimeString() : 'n/a'}</p>
                            </div>
