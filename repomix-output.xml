<file path="replication/tests/test_crud.py">
"""Crud helper unit tests."""

from __future__ import annotations

from datetime import datetime, timezone

import pytest

from replication import crud


class RecorderConn:
    def __init__(self, result: str = "INSERT 0 1") -> None:
        self.calls: list[tuple[str, tuple]] = []
        self._result = result

    async def execute(self, query: str, *args):
        self.calls.append((query, args))
        return self._result


@pytest.mark.asyncio
async def test_insert_op_if_missing_forces_unapplied(op_factory) -> None:
    op = op_factory(33)
    op.applied = True
    op.applied_ts = datetime.now(timezone.utc)
    conn = RecorderConn()

    inserted = await crud.insert_op_if_missing(conn, op)

    assert inserted is True
    _, args = conn.calls[0]
    assert args[8] is False
    assert args[9] is None
</file>

